<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HowsMyMoney.App"
             xmlns:local="using:HowsMyMoney"
             RequestedThemeVariant="Dark">
             <!-- "Dark" theme enabled by default. Can be changed to "Light" or "Default" -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Themes/DarkTheme.axaml"/>
    </Application.Styles>
</Application>