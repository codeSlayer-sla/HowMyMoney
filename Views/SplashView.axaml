<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HowsMyMoney.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:converters="using:HowsMyMoney.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="HowsMyMoney.Views.SplashView"
             x:DataType="vm:SplashViewModel">
    
    <Design.DataContext>
        <vm:SplashViewModel/>
    </Design.DataContext>
    
    <UserControl.Resources>
        <converters:ProgressToWidthConverter x:Key="ProgressToWidthConverter"/>
    </UserControl.Resources>
    
    <!-- Fondo con gradiente animado -->
    <Panel>
        <Panel.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#0A0E27" Offset="0"/>
                <GradientStop Color="#1A1D3A" Offset="0.5"/>
                <GradientStop Color="#0F1729" Offset="1"/>
            </LinearGradientBrush>
        </Panel.Background>
        
        <!-- Contenido central -->
        <StackPanel VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Spacing="40">
            
            <!-- Logo con animación -->
            <Border Opacity="{Binding LogoOpacity}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding LogoScale}" 
                                   ScaleY="{Binding LogoScale}"/>
                </Border.RenderTransform>
                
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.8">
                            <DoubleTransition.Easing>
                                <CubicEaseOut/>
                            </DoubleTransition.Easing>
                        </DoubleTransition>
                    </Transitions>
                </Border.Transitions>
                
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <!-- Icono principal con efecto glow -->
                    <Border Width="160" Height="160"
                            CornerRadius="80"
                            BoxShadow="0 0 60 20 #4000AAFF, 0 10 40 0 #80000000">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#007ACC" Offset="0"/>
                                <GradientStop Color="#00AAFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding LogoScale}" 
                                          ScaleY="{Binding LogoScale}"/>
                        </Border.RenderTransform>
                        
                        <Border.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.8">
                                    <TransformOperationsTransition.Easing>
                                        <CubicEaseOut/>
                                    </TransformOperationsTransition.Easing>
                                </TransformOperationsTransition>
                            </Transitions>
                        </Border.Transitions>
                        
                        <materialIcons:MaterialIcon Kind="CurrencyUsd" 
                                                   Width="90" Height="90"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                    </Border>
                    
                    <!-- Nombre de la app -->
                    <TextBlock Text="HowsMyMoney" 
                              FontSize="48" 
                              FontWeight="Bold" 
                              Foreground="White"
                              HorizontalAlignment="Center"
                              LetterSpacing="2"/>
                </StackPanel>
            </Border>
            
            <!-- Subtítulo y status con fade-in -->
            <StackPanel Spacing="15" 
                       Opacity="{Binding TextOpacity}"
                       HorizontalAlignment="Center">
                <StackPanel.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.5">
                            <DoubleTransition.Easing>
                                <CubicEaseOut/>
                            </DoubleTransition.Easing>
                        </DoubleTransition>
                    </Transitions>
                </StackPanel.Transitions>
                
                <TextBlock Text="Gestor Inteligente de Inversiones" 
                          FontSize="20" 
                          FontWeight="Light"
                          Foreground="#B0B0B0"
                          HorizontalAlignment="Center"
                          LetterSpacing="1"/>
                
                <!-- Barra de progreso -->
                <Border Width="300" Height="4" 
                       CornerRadius="2"
                       Background="#2D2D30"
                       Margin="0,20,0,0">
                    <Border Width="{Binding ProgressValue, Converter={StaticResource ProgressToWidthConverter}}"
                           Height="4"
                           HorizontalAlignment="Left"
                           CornerRadius="2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#007ACC" Offset="0"/>
                                <GradientStop Color="#00AAFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Width" Duration="0:0:0.3"/>
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                </Border>
                
                <!-- Texto de status -->
                <TextBlock Text="{Binding StatusText}" 
                          FontSize="14" 
                          Foreground="#808080"
                          HorizontalAlignment="Center"
                          Margin="0,10,0,0"/>
            </StackPanel>
            
            <!-- Footer -->
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center"
                       Spacing="8"
                       Opacity="{Binding TextOpacity}"
                       Margin="0,40,0,0">
                <StackPanel.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.5" Delay="0:0:0.3">
                            <DoubleTransition.Easing>
                                <CubicEaseOut/>
                            </DoubleTransition.Easing>
                        </DoubleTransition>
                    </Transitions>
                </StackPanel.Transitions>
                
                <materialIcons:MaterialIcon Kind="Security" 
                                           Width="16" Height="16" 
                                           Foreground="#606060"/>
                <TextBlock Text="Seguro" 
                          FontSize="12" 
                          Foreground="#606060"
                          VerticalAlignment="Center"/>
                
                <TextBlock Text="•" 
                          FontSize="12" 
                          Foreground="#404040"
                          Margin="5,0"
                          VerticalAlignment="Center"/>
                
                <materialIcons:MaterialIcon Kind="LightningBolt" 
                                           Width="16" Height="16" 
                                           Foreground="#606060"/>
                <TextBlock Text="Rápido" 
                          FontSize="12" 
                          Foreground="#606060"
                          VerticalAlignment="Center"/>
                
                <TextBlock Text="•" 
                          FontSize="12" 
                          Foreground="#404040"
                          Margin="5,0"
                          VerticalAlignment="Center"/>
                
                <materialIcons:MaterialIcon Kind="TrendingUp" 
                                           Width="16" Height="16" 
                                           Foreground="#606060"/>
                <TextBlock Text="En Tiempo Real" 
                          FontSize="12" 
                          Foreground="#606060"
                          VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
        
        <!-- Versión en esquina -->
        <TextBlock Text="v1.0.0" 
                  FontSize="11" 
                  Foreground="#404040"
                  Margin="20"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Opacity="{Binding TextOpacity}"/>
    </Panel>
</UserControl>
