<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HowsMyMoney.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:material="using:Material.Styles"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:converters="using:HowsMyMoney.Converters"
             xmlns:controls="using:HowsMyMoney.Views.Controls"
             xmlns:models="using:HowsMyMoney.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="HowsMyMoney.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Views/Templates/InvestmentRowTemplate.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <vm:ProfitLossColorConverter x:Key="ProfitLossColorConverter"/>
            <converters:UrlToBitmapConverter x:Key="UrlToBitmapConverter"/>
            <converters:InverseBoolToOpacityConverter x:Key="InverseBoolToOpacityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Animación para cards -->
        <Style Selector="Border.card">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Border.card:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
            <Setter Property="BoxShadow" Value="0 16 32 0 #44000000"/>
        </Style>
        
        <!-- Animación para botones -->
        <Style Selector="Button.modern">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Button.modern:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.05)"/>
        </Style>
        
        <Style Selector="Button.modern:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)"/>
        </Style>

        <!-- Pestañas de la lista de inversiones por tipo -->
        <Style Selector="Button.investmentTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9A9CA3"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.investmentTab.active">
            <Setter Property="Background" Value="{DynamicResource SummaryCardBlueAccent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <Panel>
    <!-- Background con gradiente animado -->
    <Panel.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#0F172A" Offset="0"/>
            <GradientStop Color="#1E1B4B" Offset="0.5"/>
            <GradientStop Color="#0F172A" Offset="1"/>
        </LinearGradientBrush>
    </Panel.Background>
    
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Margin="15,20">
            <!-- Header: mismo lenguaje flat/minimal que las tarjetas de resumen -->
            <Border Background="#2D2D30"
                   CornerRadius="12"
                   Padding="16"
                   Margin="0,0,0,10"
                   BorderThickness="1"
                   BorderBrush="#3E3E42">
                <Grid RowDefinitions="Auto,Auto">
                    <!-- Row 0: Título e Icono con Speech Bubble -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                        <!-- Icono de la mascota -->
                        <Border Width="40" Height="40"
                               CornerRadius="20"
                               ClipToBounds="True"
                               Background="#1A1A1A"
                               BorderThickness="1"
                               BorderBrush="#3E3E42"
                               VerticalAlignment="Center">
                            <Image Source="/Assets/Money-removebg-preview.png"
                                   Width="40" Height="40"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>

                        <!-- Speech Bubble (al lado derecho del icono) -->
                        <Border Padding="12,8"
                               CornerRadius="8"
                               Background="#1E1E1E"
                               BorderThickness="1"
                               BorderBrush="#3E3E42"
                               MaxWidth="280"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left">
                            <TextBlock Text="{Binding MascotMessage}"
                                      FontSize="13"
                                      FontWeight="Medium"
                                      Foreground="#CCCCCC"
                                      TextWrapping="Wrap"
                                      LineHeight="18"/>
                        </Border>
                    </StackPanel>

                    <!-- Row 1: Botones (se adaptan en pantallas pequeñas) -->
                    <WrapPanel Grid.Row="1"
                              Orientation="Horizontal"
                              Margin="0,12,0,0"
                              HorizontalAlignment="Right">
                        <!-- Botón Actualizar -->
                        <Button Command="{Binding UpdatePricesCommand}"
                               MinHeight="38"
                               Width="140"
                               Padding="12,0"
                               Margin="4"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="White"
                               Background="{DynamicResource SummaryCardBlueAccent}"
                               CornerRadius="8"
                               BorderThickness="0"
                               HorizontalAlignment="Right"
                               HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox Width="16" Height="16">
                                    <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                          Fill="White"/>
                                </Viewbox>
                                <TextBlock Text="Actualizar" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#2563EB"/>
                                </Style>
                            </Button.Styles>
                        </Button>

                        <!-- Botón Exportar -->
                        <Button Command="{Binding ExportToCsvCommand}"
                               MinHeight="38"
                               Width="140"
                               Padding="12,0"
                               Margin="4"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="White"
                               Background="{DynamicResource SummaryCardGreenAccent}"
                               CornerRadius="8"
                               BorderThickness="0"
                               HorizontalAlignment="Right"
                               HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox Width="16" Height="16">
                                    <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11zM8 15.01l1.41 1.41L11 14.84V19h2v-4.16l1.59 1.59L16 15.01 12.01 11z"
                                          Fill="White"/>
                                </Viewbox>
                                <TextBlock Text="Exportar" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#059669"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Tarjetas de resumen: minimal con borde de acento -->
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <controls:SummaryCardView
                    Margin="0,0,10,10"
                    IconData="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"
                    Label="INVERSIONES"
                    Value="{Binding TotalInvestments}"
                    AccentBrush="{DynamicResource SummaryCardPurpleAccent}"/>

                <controls:SummaryCardView
                    Margin="0,0,10,10"
                    IconData="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"
                    Label="INVERTIDO"
                    Value="{Binding TotalInvested, StringFormat='${0:N0}'}"
                    AccentBrush="{DynamicResource SummaryCardBlueAccent}"/>

                <controls:SummaryCardView
                    Margin="0,0,10,10"
                    IconData="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"
                    Label="VALOR ACTUAL"
                    Value="{Binding CurrentValue, StringFormat='${0:N0}'}"
                    AccentBrush="{DynamicResource SummaryCardGreenAccent}"/>

                <controls:SummaryCardView
                    Margin="0,0,10,10"
                    IconData="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z"
                    Label="GANANCIA/PÉRDIDA"
                    Value="{Binding TotalProfitLoss, StringFormat='${0:N0}'}"
                    Trend="{Binding ProfitLossPercentage, StringFormat='({0:F1}%)'}"
                    AccentBrush="{Binding TotalProfitLoss, Converter={StaticResource ProfitLossColorConverter}}"
                    ValueBrush="{Binding TotalProfitLoss, Converter={StaticResource ProfitLossColorConverter}}"/>
            </WrapPanel>

            <!-- Gráficos Premium con glassmorphism RESPONSIVE -->
            <!-- Componente unificado de gráficos con tabs -->
            <Border Classes="card"
                   CornerRadius="20" 
                   Padding="15"
                   BorderThickness="1"
                   BorderBrush="#FFFFFF10"
                   ClipToBounds="False"
                   MinHeight="300"
                   MaxHeight="500">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#1E293B" Offset="0"/>
                        <GradientStop Color="#334155" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="25" Opacity="0.4" OffsetY="8"/>
                </Border.Effect>
                
                <StackPanel>
                    <!-- Header con Tabs (Rendimiento / Distribución) -->
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,15">
                        <!-- Tabs de vista -->
                        <Border Grid.Column="0"
                               Background="#0F1419" 
                               CornerRadius="10" 
                               Padding="4"
                               BorderBrush="#FFFFFF15"
                               BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <!-- Tab Rendimiento -->
                                <Button Command="{Binding ToggleChartViewCommand}"
                                       Height="34"
                                       MinWidth="110"
                                       Padding="10,6"
                                       CornerRadius="8"
                                       Cursor="Hand"
                                       IsVisible="{Binding !IsPerformanceViewActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                            <Path Data="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z" 
                                                  Fill="#8E8E93"/>
                                        </Viewbox>
                                        <TextBlock Text="Rendimiento" 
                                                  FontSize="12" 
                                                  FontWeight="SemiBold"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="#2D2D30"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Style>
                                    </Button.Styles>
                                </Button>
                                
                                <!-- Tab Rendimiento ACTIVO -->
                                <Border Height="34"
                                       MinWidth="110"
                                       CornerRadius="8" 
                                       Padding="10,6"
                                       IsVisible="{Binding IsPerformanceViewActive}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                            <GradientStop Color="#2563EB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#3B82F6" BlurRadius="10" Opacity="0.5"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                            <Path Data="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z" 
                                                  Fill="White"/>
                                        </Viewbox>
                                        <TextBlock Text="Rendimiento" 
                                                  FontSize="12" 
                                                  FontWeight="Bold"
                                                  Foreground="White"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Tab Distribución -->
                                <Button Command="{Binding ToggleChartViewCommand}"
                                       Height="34"
                                       MinWidth="110"
                                       Padding="10,6"
                                       CornerRadius="8"
                                       Cursor="Hand"
                                       IsVisible="{Binding !IsDistributionViewActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <icons:MaterialIcon Kind="ChartPie" 
                                                          Width="16" Height="16"
                                                          Foreground="#8E8E93"
                                                          VerticalAlignment="Center"/>
                                        <TextBlock Text="Distribución" 
                                                  FontSize="12" 
                                                  FontWeight="SemiBold"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="#2D2D30"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Style>
                                    </Button.Styles>
                                </Button>
                                
                                <!-- Tab Distribución ACTIVO -->
                                <Border Height="34"
                                       MinWidth="110"
                                       CornerRadius="8" 
                                       Padding="10,6"
                                       IsVisible="{Binding IsDistributionViewActive}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="#10B981" Offset="0"/>
                                            <GradientStop Color="#059669" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#10B981" BlurRadius="10" Opacity="0.5"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <icons:MaterialIcon Kind="ChartPie" 
                                                          Width="16" Height="16"
                                                          Foreground="White"
                                                          VerticalAlignment="Center"/>
                                        <TextBlock Text="Distribución" 
                                                  FontSize="12" 
                                                  FontWeight="Bold"
                                                  Foreground="White"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        
                        <!-- Selector de período (solo visible en vista Rendimiento) -->
                        <ScrollViewer Grid.Column="1"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Disabled"
                                     HorizontalAlignment="Right"
                                     MaxWidth="300">
                            <Border Background="#0F1419" 
                                   CornerRadius="10" 
                                   Padding="4"
                                   BorderBrush="#FFFFFF15"
                                   BorderThickness="1"
                                   IsVisible="{Binding IsPerformanceViewActive}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <!-- Botón Diario -->
                                    <Button Command="{Binding ChangePeriodCommand}"
                                           CommandParameter="Daily"
                                           Width="85"
                                           Height="32"
                                           Padding="8,6"
                                           CornerRadius="6"
                                           Cursor="Hand"
                                           HorizontalContentAlignment="Center"
                                           IsEnabled="{Binding !IsLoadingChart}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <icons:MaterialIcon Kind="CalendarToday" 
                                                              Width="14" Height="14"
                                                              VerticalAlignment="Center"/>
                                            <TextBlock Text="Día" 
                                                      FontSize="12" 
                                                      FontWeight="SemiBold"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#8E8E93"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                            <Style Selector="Button[IsEnabled=True]:pointerover">
                                                <Setter Property="Background" Value="#2D2D30"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Style>
                                            <Style Selector="Button:disabled">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.IsVisible>
                                            <Binding Path="!IsDailyActive"/>
                                        </Button.IsVisible>
                                    </Button>
                                    
                                    <!-- Botón Diario ACTIVO -->
                                    <Border Width="85"
                                           Height="32"
                                           CornerRadius="6" 
                                           Padding="8,6"
                                           IsVisible="{Binding IsDailyActive}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#3B82F6" Offset="0"/>
                                                <GradientStop Color="#2563EB" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <icons:MaterialIcon Kind="CalendarToday" 
                                                              Width="14" Height="14"
                                                              Foreground="White"
                                                              VerticalAlignment="Center"/>
                                            <TextBlock Text="Día" 
                                                      FontSize="12" 
                                                      FontWeight="Bold"
                                                      Foreground="White"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Botón Semanal -->
                                    <Button Command="{Binding ChangePeriodCommand}"
                                           CommandParameter="Weekly"
                                           Width="85"
                                           Height="32"
                                           Padding="8,6"
                                           CornerRadius="6"
                                           Cursor="Hand"
                                           HorizontalContentAlignment="Center"
                                           IsEnabled="{Binding !IsLoadingChart}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <icons:MaterialIcon Kind="CalendarWeek" 
                                                              Width="14" Height="14"
                                                              VerticalAlignment="Center"/>
                                            <TextBlock Text="Semana" 
                                                      FontSize="12" 
                                                      FontWeight="SemiBold"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#8E8E93"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                            <Style Selector="Button[IsEnabled=True]:pointerover">
                                                <Setter Property="Background" Value="#2D2D30"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Style>
                                            <Style Selector="Button:disabled">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.IsVisible>
                                            <Binding Path="!IsWeeklyActive"/>
                                        </Button.IsVisible>
                                    </Button>
                                    
                                    <!-- Botón Semanal ACTIVO -->
                                    <Border Width="85"
                                           Height="32"
                                           CornerRadius="6" 
                                           Padding="8,6"
                                           IsVisible="{Binding IsWeeklyActive}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#3B82F6" Offset="0"/>
                                                <GradientStop Color="#2563EB" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <icons:MaterialIcon Kind="CalendarWeek" 
                                                              Width="14" Height="14"
                                                              Foreground="White"
                                                              VerticalAlignment="Center"/>
                                            <TextBlock Text="Semana" 
                                                      FontSize="12" 
                                                      FontWeight="Bold"
                                                      Foreground="White"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Botón Mensual -->
                                    <Button Command="{Binding ChangePeriodCommand}"
                                           CommandParameter="Monthly"
                                           Width="85"
                                           Height="32"
                                           Padding="8,6"
                                           CornerRadius="6"
                                           Cursor="Hand"
                                           HorizontalContentAlignment="Center"
                                           IsEnabled="{Binding !IsLoadingChart}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <icons:MaterialIcon Kind="CalendarMonth" 
                                                              Width="14" Height="14"
                                                              VerticalAlignment="Center"/>
                                            <TextBlock Text="Mes" 
                                                      FontSize="12" 
                                                      FontWeight="SemiBold"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#8E8E93"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                            <Style Selector="Button[IsEnabled=True]:pointerover">
                                                <Setter Property="Background" Value="#2D2D30"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Style>
                                            <Style Selector="Button:disabled">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.IsVisible>
                                            <Binding Path="!IsMonthlyActive"/>
                                        </Button.IsVisible>
                                    </Button>
                                    
                                    <!-- Botón Mensual ACTIVO -->
                                    <Border Width="85"
                                           Height="32"
                                           CornerRadius="6" 
                                           Padding="8,6"
                                           IsVisible="{Binding IsMonthlyActive}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#3B82F6" Offset="0"/>
                                                <GradientStop Color="#2563EB" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <icons:MaterialIcon Kind="CalendarMonth" 
                                                              Width="14" Height="14"
                                                              Foreground="White"
                                                              VerticalAlignment="Center"/>
                                            <TextBlock Text="Mes" 
                                                      FontSize="12" 
                                                      FontWeight="Bold"
                                                      Foreground="White"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                    
                    <!-- VISTA DE RENDIMIENTO -->
                    <StackPanel IsVisible="{Binding IsPerformanceViewActive}" Margin="0,15,0,0">
                        <!-- Contenedor del gráfico con loading -->
                        <Grid Height="300">
                            <!-- Gráfico -->
                            <lvc:CartesianChart Series="{Binding MonthlyPerformanceSeries}"
                                               XAxes="{Binding XAxes}"
                                               YAxes="{Binding YAxes}"
                                               Opacity="{Binding IsLoadingChart, Converter={StaticResource InverseBoolToOpacityConverter}}"/>
                            
                            <!-- Indicador de carga -->
                            <Border Background="#2D2D30F0" 
                                   CornerRadius="12"
                                   IsVisible="{Binding IsLoadingChart}">
                                <StackPanel HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           Spacing="16">
                                    <Border Width="60" Height="60" 
                                           CornerRadius="30"
                                           BoxShadow="0 4 16 0 #603B82F6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#3B82F6" Offset="0"/>
                                                <GradientStop Color="#2563EB" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <icons:MaterialIcon Kind="ChartLineVariant" 
                                                          Width="32" Height="32"
                                                          Foreground="White"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Cargando datos del gráfico..." 
                                              FontSize="14" 
                                              FontWeight="SemiBold"
                                              Foreground="#FFFFFF"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                    
                    <!-- VISTA DE DISTRIBUCIÓN -->
                    <StackPanel IsVisible="{Binding IsDistributionViewActive}" Margin="0,15,0,0">
                        <lvc:PieChart Series="{Binding AssetDistributionSeries}" 
                                     Height="320"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Resumen de Criptomonedas Premium -->
            <Border Classes="card"
                   CornerRadius="20" 
                   Padding="30"
                   BorderThickness="1"
                   BorderBrush="#FFFFFF10"
                   ClipToBounds="False"
                   IsVisible="{Binding CryptoSummaries.Count}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#1E293B" Offset="0"/>
                        <GradientStop Color="#334155" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="25" Opacity="0.4" OffsetY="8"/>
                </Border.Effect>
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,25">
                        <icons:MaterialIcon Grid.Column="0"
                                          Kind="Bitcoin" 
                                          Width="28" Height="28" 
                                          Foreground="#9CA3AF"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1"
                                  Text="Resumen de Criptomonedas" 
                                  FontSize="22" 
                                  FontWeight="ExtraBold"
                                  Foreground="#FFFFFF"
                                  VerticalAlignment="Center"/>
                        <Border Grid.Column="3"
                               Background="#8B5CF6"
                               CornerRadius="12"
                               Padding="10,6"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="Counter" Width="16" Height="16" Foreground="White" Background="#00000000"/>
                                <TextBlock Text="{Binding CryptoSummaries.Count, StringFormat='{}{0} activos'}"
                                          FontSize="12"
                                          FontWeight="Bold"
                                          Foreground="White"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <ItemsControl ItemsSource="{Binding CryptoSummaries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E1E" 
                                       Classes="card"
                                       CornerRadius="12" 
                                       Padding="24" 
                                       Margin="0,0,0,12"
                                       BorderBrush="#3E3E42"
                                       BorderThickness="1"
                                       BoxShadow="0 4 12 0 #22000000">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                                        <!-- Imagen -->
                                        <Border Grid.Column="0"
                                               Width="40" 
                                               Height="40" 
                                               CornerRadius="20"
                                               ClipToBounds="True"
                                               Background="#3C3C3C"
                                               Margin="0,0,20,0">
                                            <Image Source="{Binding ImageBitmap}" 
                                                  Stretch="UniformToFill"/>
                                        </Border>
                                        
                                        <!-- Símbolo y Cantidad -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Symbol}" 
                                                      FontSize="16" 
                                                      FontWeight="Bold"
                                                      Foreground="White"/>
                                            <TextBlock FontSize="12" Foreground="#AAAAAA">
                                                <Run Text="{Binding TotalQuantity, StringFormat='{}{0:N8}'}"/>
                                                <Run Text=" unidades"/>
                                            </TextBlock>
                                        </StackPanel>
                                        
                                        <!-- Precio Actual -->
                                        <StackPanel Grid.Column="2" Margin="20,0" VerticalAlignment="Center">
                                            <TextBlock Text="Precio" FontSize="11" Foreground="#AAAAAA"/>
                                            <TextBlock Text="{Binding CurrentPrice, StringFormat='${0:N2}'}" 
                                                      FontSize="14" 
                                                      FontWeight="Bold"
                                                      Foreground="#4FC3F7"/>
                                        </StackPanel>
                                        
                                        <!-- Valor Total -->
                                        <StackPanel Grid.Column="3" Margin="20,0" VerticalAlignment="Center">
                                            <TextBlock Text="Valor Total" FontSize="11" Foreground="#AAAAAA"/>
                                            <TextBlock Text="{Binding CurrentValue, StringFormat='${0:N2}'}" 
                                                      FontSize="14" 
                                                      FontWeight="Bold"
                                                      Foreground="White"/>
                                        </StackPanel>
                                        
                                        <!-- Ganancia/Pérdida -->
                                        <Border Grid.Column="4"
                                               Background="#3E3E42"
                                               CornerRadius="6"
                                               Padding="15,8"
                                               Margin="20,0"
                                               VerticalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProfitLoss, StringFormat='${0:N2}'}" 
                                                          FontSize="15" 
                                                          FontWeight="Bold"
                                                          Foreground="{Binding ProfitLoss, Converter={StaticResource ProfitLossColorConverter}}"
                                                          HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding ProfitLossPercentage, StringFormat='({0:F2}%)'}" 
                                                          FontSize="12" 
                                                          FontWeight="SemiBold"
                                                          Foreground="{Binding ProfitLoss, Converter={StaticResource ProfitLossColorConverter}}"
                                                          HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Botón Ajustar Earnings -->
                                        <Button Grid.Column="5"
                                               Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).OpenAdjustCryptoDialogCommand}"
                                               CommandParameter="{Binding}"
                                               Classes="modern"
                                               Width="50"
                                               Height="46"
                                               Padding="12,10"
                                               Foreground="White"
                                               CornerRadius="10"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               HorizontalContentAlignment="Center"
                                               ToolTip.Tip="Ajustar cantidad por earnings/staking">
                                            <icons:MaterialIcon Kind="ChartTimelineVariant" Width="22" Height="22"/>
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                                    <GradientStop Color="#1D4ED8" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background">
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                            <GradientStop Color="#2563EB" Offset="0"/>
                                                            <GradientStop Color="#1E40AF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter>
                                                </Style>
                                            </Button.Styles>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Inversiones por tipo: pestañas en vez de 4 secciones apiladas -->
            <Border Background="#2D2D30"
                   Classes="card"
                   CornerRadius="14"
                   Padding="25"
                   BoxShadow="0 8 16 0 #22000000"
                   BorderBrush="#3E3E42"
                   BorderThickness="1">
                <StackPanel Spacing="16">
                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="investmentTab" Classes.active="{Binding IsCryptoTabActive}"
                               Command="{Binding SelectInvestmentTabCommand}"
                               CommandParameter="{x:Static models:AssetType.Criptomoneda}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="CurrencyBtc" Width="16" Height="16"/>
                                <TextBlock Text="{Binding CryptoInvestments.Count, StringFormat='Cripto · {0}'}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="investmentTab" Classes.active="{Binding IsSkinTabActive}"
                               Command="{Binding SelectInvestmentTabCommand}"
                               CommandParameter="{x:Static models:AssetType.SkinCSGO}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="SwordCross" Width="16" Height="16"/>
                                <TextBlock Text="{Binding SkinInvestments.Count, StringFormat='Skins · {0}'}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="investmentTab" Classes.active="{Binding IsStockTabActive}"
                               Command="{Binding SelectInvestmentTabCommand}"
                               CommandParameter="{x:Static models:AssetType.Accion}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="ChartLine" Width="16" Height="16"/>
                                <TextBlock Text="{Binding StockInvestments.Count, StringFormat='Acciones · {0}'}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="investmentTab" Classes.active="{Binding IsManualTabActive}"
                               Command="{Binding SelectInvestmentTabCommand}"
                               CommandParameter="{x:Static models:AssetType.Manual}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="PencilBox" Width="16" Height="16"/>
                                <TextBlock Text="{Binding ManualInvestments.Count, StringFormat='Manual · {0}'}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto"
                                 IsVisible="{Binding IsCryptoTabActive}">
                        <ItemsControl ItemsSource="{Binding CryptoInvestments}" ItemTemplate="{StaticResource InvestmentRowTemplate}"/>
                    </ScrollViewer>
                    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto"
                                 IsVisible="{Binding IsSkinTabActive}">
                        <ItemsControl ItemsSource="{Binding SkinInvestments}" ItemTemplate="{StaticResource InvestmentRowTemplate}"/>
                    </ScrollViewer>
                    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto"
                                 IsVisible="{Binding IsStockTabActive}">
                        <ItemsControl ItemsSource="{Binding StockInvestments}" ItemTemplate="{StaticResource InvestmentRowTemplate}"/>
                    </ScrollViewer>
                    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto"
                                 IsVisible="{Binding IsManualTabActive}">
                        <ItemsControl ItemsSource="{Binding ManualInvestments}" ItemTemplate="{StaticResource InvestmentRowTemplate}"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Barra de estado -->
            <TextBlock Text="{Binding StatusMessage}" 
                      FontSize="12" 
                      Foreground="#7F8C8D"
                      HorizontalAlignment="Right"/>
        </StackPanel>
    </ScrollViewer>

    <!-- Diálogo de Ajuste de Criptomoneda -->
    <Border IsVisible="{Binding IsAdjustmentDialogOpen}"
            Background="#CC000000"
            ZIndex="1000">
        <Border Background="#2D2D30"
               CornerRadius="12"
               Padding="30"
               MaxWidth="500"
               MaxHeight="400"
               BorderBrush="#007ACC"
               BorderThickness="2"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               BoxShadow="0 12 24 0 #88000000">
            <StackPanel Spacing="20">
                <!-- Título -->
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <icons:MaterialIcon Kind="ChartTimelineVariant" Width="28" Height="28" Foreground="#3B82F6" VerticalAlignment="Center"/>
                    <TextBlock Text="Ajustar Cantidad por Earnings" 
                              FontSize="22" 
                              FontWeight="Bold"
                              Foreground="White"
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Información de la cripto -->
                <StackPanel Spacing="10" IsVisible="{Binding SelectedCryptoForAdjustment}">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                  Text="Criptomoneda:" 
                                  FontSize="14" 
                                  Foreground="#AAAAAA"
                                  Margin="0,0,15,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                  Text="{Binding SelectedCryptoForAdjustment.Symbol}" 
                                  FontSize="14" 
                                  FontWeight="Bold"
                                  Foreground="White"
                                  Margin="0,0,0,5"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" 
                                  Text="Cantidad actual:" 
                                  FontSize="14" 
                                  Foreground="#AAAAAA"
                                  Margin="0,0,15,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" 
                                  Text="{Binding SelectedCryptoForAdjustment.TotalQuantity, StringFormat='{}{0:N8} unidades'}" 
                                  FontSize="14" 
                                  Foreground="#4FC3F7"
                                  Margin="0,0,0,5"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" 
                                  Text="Valor actual:" 
                                  FontSize="14" 
                                  Foreground="#AAAAAA"
                                  Margin="0,0,15,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" 
                                  Text="{Binding SelectedCryptoForAdjustment.CurrentValue, StringFormat='${0:N2}'}" 
                                  FontSize="14" 
                                  Foreground="#4CAF50"/>
                    </Grid>
                </StackPanel>
                
                <Border Height="1" Background="#3E3E42"/>
                
                <!-- Input de nueva cantidad -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Nueva cantidad total (después de earnings/staking):" 
                              FontSize="14" 
                              Foreground="White"/>
                    <TextBox Text="{Binding NewCryptoQuantity}"
                            Watermark="Ej: 0.00192500"
                            FontSize="16"
                            Padding="12"
                            Background="#1E1E1E"
                            Foreground="White"
                            BorderBrush="#007ACC"
                            BorderThickness="2"
                            CornerRadius="6"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="5,5,0,0">
                        <icons:MaterialIcon Kind="CheckCircle" Width="14" Height="14" Foreground="#4CAF50" VerticalAlignment="Center"/>
                        <TextBlock FontSize="11"
                                  Foreground="#4CAF50"
                                  TextWrapping="Wrap"
                                  Text="Se creará un nuevo registro marcado como [EARNING]"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="5,3,0,0">
                        <icons:MaterialIcon Kind="LightbulbOn" Width="14" Height="14" Foreground="#FFA726" VerticalAlignment="Center"/>
                        <TextBlock FontSize="11"
                                  Foreground="#FFA726"
                                  TextWrapping="Wrap"
                                  Text="Tus compras originales NO se modificarán (mantiene trazabilidad)"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Botones -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,0">
                    <Button Grid.Column="0"
                           Command="{Binding CloseAdjustCryptoDialogCommand}"
                           Padding="15,10"
                           Background="#424242"
                           Foreground="White"
                           CornerRadius="8"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:MaterialIcon Kind="Close" Width="18" Height="18"/>
                            <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#616161"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    
                    <Button Grid.Column="1"
                           Command="{Binding AdjustCryptoQuantityCommand}"
                           Padding="15,10"
                           Background="#3B82F6"
                           Foreground="White"
                           CornerRadius="8"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:MaterialIcon Kind="Check" Width="18" Height="18"/>
                            <TextBlock Text="Ajustar" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Border>

    <!-- Diálogo de confirmación de eliminación -->
    <Border IsVisible="{Binding IsDeleteConfirmationOpen}"
            Background="#CC000000"
            ZIndex="1000">
        <Border Background="#2D2D30"
               CornerRadius="12"
               Padding="30"
               MaxWidth="420"
               BorderBrush="#DC2626"
               BorderThickness="2"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               BoxShadow="0 12 24 0 #88000000">
            <StackPanel Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <icons:MaterialIcon Kind="AlertCircle" Width="28" Height="28" Foreground="#DC2626" VerticalAlignment="Center"/>
                    <TextBlock Text="Eliminar inversión"
                              FontSize="22"
                              FontWeight="Bold"
                              Foreground="White"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock TextWrapping="Wrap"
                          FontSize="14"
                          Foreground="#CCCCCC"
                          HorizontalAlignment="Center"
                          TextAlignment="Center">
                    <Run Text="¿Seguro que querés eliminar"/>
                    <Run Text="{Binding InvestmentPendingDelete.Investment.Name}" FontWeight="Bold" Foreground="White"/>
                    <Run Text="? Esta acción no se puede deshacer."/>
                </TextBlock>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <Button Grid.Column="0"
                           Command="{Binding CancelDeleteInvestmentCommand}"
                           Padding="15,10"
                           Background="#424242"
                           Foreground="White"
                           CornerRadius="8"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:MaterialIcon Kind="Close" Width="18" Height="18"/>
                            <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#616161"/>
                            </Style>
                        </Button.Styles>
                    </Button>

                    <Button Grid.Column="1"
                           Command="{Binding ConfirmDeleteInvestmentCommand}"
                           Padding="15,10"
                           Background="#DC2626"
                           Foreground="White"
                           CornerRadius="8"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:MaterialIcon Kind="Delete" Width="18" Height="18"/>
                            <TextBlock Text="Eliminar" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#B91C1C"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Border>
    </Panel>

</UserControl>
