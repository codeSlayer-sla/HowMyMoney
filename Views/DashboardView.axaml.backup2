<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HowsMyMoney.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:material="using:Material.Styles"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:converters="using:HowsMyMoney.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="HowsMyMoney.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <UserControl.Resources>
        <vm:ProfitLossColorConverter x:Key="ProfitLossColorConverter"/>
        <converters:UrlToBitmapConverter x:Key="UrlToBitmapConverter"/>
        <converters:InverseBoolToOpacityConverter x:Key="InverseBoolToOpacityConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Animación para cards -->
        <Style Selector="Border.card">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Border.card:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
            <Setter Property="BoxShadow" Value="0 16 32 0 #44000000"/>
        </Style>
        
        <!-- Animación para botones -->
        <Style Selector="Button.modern">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Button.modern:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.05)"/>
        </Style>
        
        <Style Selector="Button.modern:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)"/>
        </Style>
    </UserControl.Styles>

    <Panel>
    <!-- Background con gradiente animado -->
    <Panel.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#0F172A" Offset="0"/>
            <GradientStop Color="#1E1B4B" Offset="0.5"/>
            <GradientStop Color="#0F172A" Offset="1"/>
        </LinearGradientBrush>
    </Panel.Background>
    
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Margin="15,20">
            <!-- Header Premium con glassmorphism RESPONSIVE -->
            <Border CornerRadius="20" 
                   Padding="15"
                   Margin="0,0,0,10"
                   BorderThickness="1"
                   BorderBrush="#FFFFFF15">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#1E293B" Offset="0"/>
                        <GradientStop Color="#334155" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" Opacity="0.5" OffsetX="0" OffsetY="10"/>
                </Border.Effect>
                
                <Grid RowDefinitions="Auto,Auto">
                    <!-- Row 0: Título e Icono -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                        <Border Width="42" Height="42" 
                               CornerRadius="10"
                               Background="#1A1A1A"
                               BorderThickness="2"
                               BorderBrush="#8B5CF660">
                            <Viewbox Width="24" Height="24">
                                <Path Data="M3,3L21,21M3,21L21,3M7,12H17M12,7V17" 
                                      Stroke="#A78BFA" 
                                      StrokeThickness="2" 
                                      StrokeLineCap="Round"/>
                            </Viewbox>
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" BlurRadius="20" Opacity="0.6"/>
                            </Border.Effect>
                        </Border>
                        
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="Dashboard de Inversiones" 
                                      FontSize="18" 
                                      FontWeight="Black"
                                      Foreground="#FFFFFF"
                                      LetterSpacing="0.5"
                                      TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Background="#10B98120" 
                                       CornerRadius="4" 
                                       Padding="5,2">
                                    <TextBlock Text="🔥 En vivo" 
                                              FontSize="10" 
                                              FontWeight="Bold"
                                              Foreground="#10B981"/>
                                </Border>
                                <TextBlock Text="Tiempo real" 
                                          FontSize="11" 
                                          Foreground="#94A3B8"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Row 1: Botones (se adaptan en pantallas pequeñas) -->
                    <WrapPanel Grid.Row="1"
                              Orientation="Horizontal" 
                              Margin="0,12,0,0"
                              HorizontalAlignment="Right">
                        <!-- Botón Actualizar -->
                        <Button Command="{Binding UpdatePricesCommand}"
                               Classes="modern"
                               MinHeight="40"
                               MinWidth="130"
                               Padding="12,0"
                               Margin="4"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="White"
                               CornerRadius="10"
                               BorderThickness="1"
                               BorderBrush="#3B82F640">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                    <GradientStop Color="#6366F1" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Effect>
                                <DropShadowEffect Color="#3B82F6" BlurRadius="15" Opacity="0.4"/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox Width="18" Height="18">
                                    <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" 
                                          Fill="White"/>
                                </Viewbox>
                                <TextBlock Text="Actualizar" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background">
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="#2563EB" Offset="0"/>
                                            <GradientStop Color="#4F46E5" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter>
                                </Style>
                            </Button.Styles>
                        </Button>
                        
                        <!-- Botón Exportar -->
                        <Button Command="{Binding ExportToCsvCommand}"
                               Classes="modern"
                               MinHeight="40"
                               MinWidth="130"
                               Padding="12,0"
                               Margin="4"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="White"
                               CornerRadius="10"
                               BorderThickness="1"
                               BorderBrush="#10B98140">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="#10B981" Offset="0"/>
                                    <GradientStop Color="#14B8A6" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="15" Opacity="0.4"/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox Width="18" Height="18">
                                    <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11zM8 15.01l1.41 1.41L11 14.84V19h2v-4.16l1.59 1.59L16 15.01 12.01 11z" 
                                          Fill="White"/>
                                </Viewbox>
                                <TextBlock Text="Exportar" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background">
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="#059669" Offset="0"/>
                                            <GradientStop Color="#0D9488" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Tarjetas de resumen premium con glassmorphism RESPONSIVE -->
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Total Inversiones - Purple Theme -->
                <Border Classes="card"
                       CornerRadius="18" 
                       Padding="15"
                       Margin="5"
                       MinWidth="160"
                       MaxWidth="320"
                       BorderThickness="1"
                       BorderBrush="#8B5CF630"
                       ClipToBounds="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#7C3AED" Offset="0"/>
                            <GradientStop Color="#5B21B6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#7C3AED" BlurRadius="25" Opacity="0.35" OffsetY="8"/>
                    </Border.Effect>
                    
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Icono con fondo oscuro sólido -->
                        <Border Grid.Row="0" 
                               Width="42" Height="42"
                               CornerRadius="10"
                               Background="#1A1A1A"
                               BorderBrush="#FFFFFF20"
                               BorderThickness="1"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,12">
                            <Viewbox Width="24" Height="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Path Data="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" 
                                      Fill="White"/>
                            </Viewbox>
                            <Border.Effect>
                                <DropShadowEffect Color="#FFFFFF" BlurRadius="12" Opacity="0.3"/>
                            </Border.Effect>
                        </Border>
                        
                        <!-- Label -->
                        <TextBlock Grid.Row="1"
                                  Text="Total Inversiones" 
                                  FontSize="12" 
                                  Foreground="#FFFFFF"
                                  Opacity="0.8"
                                  FontWeight="SemiBold"
                                  LetterSpacing="0.5"
                                  VerticalAlignment="Center"
                                  TextWrapping="Wrap"/>
                        
                        <!-- Valor -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" FlowDirection="LeftToRight">
                            <TextBlock Text="{Binding TotalInvestments}" 
                                      FontSize="36" 
                                      FontWeight="Black"
                                      Foreground="#FFFFFF"
                                      LetterSpacing="1"/>
                            <Border Background="#FFFFFF20"
                                   CornerRadius="6"
                                   Padding="6,3"
                                   VerticalAlignment="Center">
                                <TextBlock Text="activos" 
                                          FontSize="10" 
                                          FontWeight="Bold"
                                          Foreground="#FFFFFF"
                                          Opacity="0.9"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Invertido - Blue Theme -->
                <Border Classes="card"
                       CornerRadius="18" 
                       Padding="15"
                       Margin="5"
                       MinWidth="160"
                       MaxWidth="320"
                       BorderThickness="1"
                       BorderBrush="#3B82F630"
                       ClipToBounds="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#1E40AF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#3B82F6" BlurRadius="25" Opacity="0.35" OffsetY="8"/>
                    </Border.Effect>
                    
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0" 
                               Width="42" Height="42"
                               CornerRadius="10"
                               Background="#1A1A1A"
                               BorderBrush="#FFFFFF20"
                               BorderThickness="1"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,12">
                            <Viewbox Width="24" Height="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Path Data="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" 
                                      Fill="White"/>
                            </Viewbox>
                            <Border.Effect>
                                <DropShadowEffect Color="#FFFFFF" BlurRadius="12" Opacity="0.3"/>
                            </Border.Effect>
                        </Border>
                        
                        <TextBlock Grid.Row="1"
                                  Text="Total Invertido" 
                                  FontSize="12" 
                                  Foreground="#FFFFFF"
                                  Opacity="0.8"
                                  FontWeight="SemiBold"
                                  LetterSpacing="0.5"
                                  VerticalAlignment="Center"
                                  TextWrapping="Wrap"/>
                        
                        <TextBlock Grid.Row="2"
                                  Text="{Binding TotalInvested, StringFormat='${0:N0}'}" 
                                  FontSize="34" 
                                  FontWeight="Black"
                                  Foreground="#FFFFFF"
                                  LetterSpacing="1"/>
                    </Grid>
                </Border>

                <!-- Valor Actual - Green Theme -->
                <Border Classes="card"
                       CornerRadius="18" 
                       Padding="15"
                       Margin="5"
                       MinWidth="160"
                       MaxWidth="320"
                       BorderThickness="1"
                       BorderBrush="#10B98130"
                       ClipToBounds="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#10B981" Offset="0"/>
                            <GradientStop Color="#047857" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#10B981" BlurRadius="25" Opacity="0.35" OffsetY="8"/>
                    </Border.Effect>
                    
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0" 
                               Width="42" Height="42"
                               CornerRadius="10"
                               Background="#1A1A1A"
                               BorderBrush="#FFFFFF20"
                               BorderThickness="1"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,12">
                            <Viewbox Width="24" Height="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" 
                                      Fill="White"/>
                            </Viewbox>
                            <Border.Effect>
                                <DropShadowEffect Color="#FFFFFF" BlurRadius="12" Opacity="0.3"/>
                            </Border.Effect>
                        </Border>
                        
                        <TextBlock Grid.Row="1"
                                  Text="Valor Actual" 
                                  FontSize="12" 
                                  Foreground="#FFFFFF"
                                  Opacity="0.8"
                                  FontWeight="SemiBold"
                                  LetterSpacing="0.5"
                                  VerticalAlignment="Center"
                                  TextWrapping="Wrap"/>
                        
                        <TextBlock Grid.Row="2"
                                  Text="{Binding CurrentValue, StringFormat='${0:N0}'}" 
                                  FontSize="34" 
                                  FontWeight="Black"
                                  Foreground="#FFFFFF"
                                  LetterSpacing="1"/>
                    </Grid>
                </Border>

                <!-- Ganancia/Pérdida - Orange Theme -->
                <Border Classes="card"
                       CornerRadius="18" 
                       Padding="15"
                       Margin="5"
                       MinWidth="160"
                       MaxWidth="320"
                       BorderThickness="1"
                       BorderBrush="#F59E0B30"
                       ClipToBounds="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#F59E0B" Offset="0"/>
                            <GradientStop Color="#D97706" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#F59E0B" BlurRadius="25" Opacity="0.35" OffsetY="8"/>
                    </Border.Effect>
                    
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0" 
                               Width="42" Height="42"
                               CornerRadius="10"
                               Background="#1A1A1A"
                               BorderBrush="#FFFFFF20"
                               BorderThickness="1"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,12">
                            <Viewbox Width="24" Height="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Path Data="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z" 
                                      Fill="White"/>
                            </Viewbox>
                            <Border.Effect>
                                <DropShadowEffect Color="#FFFFFF" BlurRadius="12" Opacity="0.3"/>
                            </Border.Effect>
                        </Border>
                        
                        <TextBlock Grid.Row="1"
                                  Text="Ganancia/Pérdida" 
                                  FontSize="12" 
                                  Foreground="#FFFFFF"
                                  Opacity="0.8"
                                  FontWeight="SemiBold"
                                  LetterSpacing="0.5"
                                  VerticalAlignment="Center"
                                  TextWrapping="Wrap"/>
                        
                        <StackPanel Grid.Row="2" Spacing="4">
                            <TextBlock Text="{Binding TotalProfitLoss, StringFormat='${0:N0}'}" 
                                      FontSize="34" 
                                      FontWeight="Black"
                                      Foreground="#FFFFFF"
                                      LetterSpacing="1"/>
                            <Border Background="#FFFFFF20"
                                   CornerRadius="6"
                                   Padding="8,3"
                                   HorizontalAlignment="Left">
                                <TextBlock Text="{Binding ProfitLossPercentage, StringFormat='+{0:F1}%'}" 
                                          FontSize="12" 
                                          FontWeight="Bold"
                                          Foreground="#FFFFFF"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

            </WrapPanel>

            <!-- Gráficos Premium con glassmorphism RESPONSIVE -->
            <!-- Componente unificado de gráficos con tabs -->
            <Border Classes="card"
                   CornerRadius="20" 
                   Padding="15"
                   BorderThickness="1"
                   BorderBrush="#FFFFFF10"
                   ClipToBounds="False"
                   MinHeight="300"
                   MaxHeight="500">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#1E293B" Offset="0"/>
                        <GradientStop Color="#334155" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="25" Opacity="0.4" OffsetY="8"/>
                </Border.Effect>
                
                <StackPanel>
                    <!-- Header con Tabs (Rendimiento / Distribución) -->
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,15">
                        <!-- Tabs de vista -->
                        <Border Grid.Column="0"
                               Background="#0F1419" 
                               CornerRadius="10" 
                               Padding="4"
                               BorderBrush="#FFFFFF15"
                               BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <!-- Tab Rendimiento -->
                                <Button Command="{Binding ToggleChartViewCommand}"
                                       Height="34"
                                       MinWidth="110"
                                       Padding="10,6"
                                       CornerRadius="8"
                                       Cursor="Hand"
                                       IsVisible="{Binding !IsPerformanceViewActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                            <Path Data="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z" 
                                                  Fill="#8E8E93"/>
                                        </Viewbox>
                                        <TextBlock Text="Rendimiento" 
                                                  FontSize="12" 
                                                  FontWeight="SemiBold"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="#2D2D30"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Style>
                                    </Button.Styles>
                                </Button>
                                
                                <!-- Tab Rendimiento ACTIVO -->
                                <Border Height="34"
                                       MinWidth="110"
                                       CornerRadius="8" 
                                       Padding="10,6"
                                       IsVisible="{Binding IsPerformanceViewActive}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                            <GradientStop Color="#2563EB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#3B82F6" BlurRadius="10" Opacity="0.5"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                            <Path Data="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z" 
                                                  Fill="White"/>
                                        </Viewbox>
                                        <TextBlock Text="Rendimiento" 
                                                  FontSize="12" 
                                                  FontWeight="Bold"
                                                  Foreground="White"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Tab Distribución -->
                                <Button Command="{Binding ToggleChartViewCommand}"
                                       Height="34"
                                       MinWidth="110"
                                       Padding="10,6"
                                       CornerRadius="8"
                                       Cursor="Hand"
                                       IsVisible="{Binding !IsDistributionViewActive}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <icons:MaterialIcon Kind="ChartPie" 
                                                          Width="16" Height="16"
                                                          Foreground="#8E8E93"
                                                          VerticalAlignment="Center"/>
                                        <TextBlock Text="Distribución" 
                                                  FontSize="12" 
                                                  FontWeight="SemiBold"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="#2D2D30"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Style>
                                    </Button.Styles>
                                </Button>
                                
                                <!-- Tab Distribución ACTIVO -->
                                <Border Height="34"
                                       MinWidth="110"
                                       CornerRadius="8" 
                                       Padding="10,6"
                                       IsVisible="{Binding IsDistributionViewActive}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="#10B981" Offset="0"/>
                                            <GradientStop Color="#059669" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#10B981" BlurRadius="10" Opacity="0.5"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <icons:MaterialIcon Kind="ChartPie" 
                                                          Width="16" Height="16"
                                                          Foreground="White"
                                                          VerticalAlignment="Center"/>
                                        <TextBlock Text="Distribución" 
                                                  FontSize="12" 
                                                  FontWeight="Bold"
                                                  Foreground="White"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        
                        <!-- Selector de período (solo visible en vista Rendimiento) -->
                        <Border Grid.Column="1"
                               Background="#0F1419" 
                               CornerRadius="10" 
                               Padding="4"
                               HorizontalAlignment="Right"
                               BorderBrush="#FFFFFF15"
                               BorderThickness="1"
                               IsVisible="{Binding IsPerformanceViewActive}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <!-- Botón Diario -->
                                    <Button Command="{Binding ChangePeriodCommand}"
                                           CommandParameter="Daily"
                                           MinWidth="70"
                                           Height="30"
                                           Padding="6,4"
                                           CornerRadius="6"
                                           Cursor="Hand"
                                           IsEnabled="{Binding !IsLoadingChart}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                                <Path Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z" 
                                                      Fill="#8E8E93"/>
                                            </Viewbox>
                                            <TextBlock Text="Día" 
                                                      FontSize="11" 
                                                      FontWeight="SemiBold"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#8E8E93"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                            <Style Selector="Button[IsEnabled=True]:pointerover">
                                                <Setter Property="Background" Value="#2D2D30"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Style>
                                            <Style Selector="Button:disabled">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.IsVisible>
                                            <Binding Path="!IsDailyActive"/>
                                        </Button.IsVisible>
                                    </Button>
                                    
                                    <!-- Botón Diario ACTIVO -->
                                    <Border Width="80"
                                           Height="32"
                                           CornerRadius="6" 
                                           Padding="8,6"
                                           IsVisible="{Binding IsDailyActive}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#3B82F6" Offset="0"/>
                                                <GradientStop Color="#2563EB" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <icons:MaterialIcon Kind="CalendarToday" 
                                                              Width="14" Height="14"
                                                              Foreground="White"
                                                              VerticalAlignment="Center"/>
                                            <TextBlock Text="Día" 
                                                      FontSize="12" 
                                                      FontWeight="Bold"
                                                      Foreground="White"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Botón Semanal -->
                                    <Button Command="{Binding ChangePeriodCommand}"
                                           CommandParameter="Weekly"
                                           Width="90"
                                           Height="32"
                                           Padding="8,6"
                                           CornerRadius="6"
                                           Cursor="Hand"
                                           IsEnabled="{Binding !IsLoadingChart}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <icons:MaterialIcon Kind="CalendarWeek" 
                                                              Width="14" Height="14"
                                                              VerticalAlignment="Center"/>
                                            <TextBlock Text="Semana" 
                                                      FontSize="12" 
                                                      FontWeight="SemiBold"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#8E8E93"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                            <Style Selector="Button[IsEnabled=True]:pointerover">
                                                <Setter Property="Background" Value="#2D2D30"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Style>
                                            <Style Selector="Button:disabled">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.IsVisible>
                                            <Binding Path="!IsWeeklyActive"/>
                                        </Button.IsVisible>
                                    </Button>
                                    
                                    <!-- Botón Semanal ACTIVO -->
                                    <Border Width="90"
                                           Height="32"
                                           CornerRadius="6" 
                                           Padding="8,6"
                                           IsVisible="{Binding IsWeeklyActive}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#3B82F6" Offset="0"/>
                                                <GradientStop Color="#2563EB" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <icons:MaterialIcon Kind="CalendarWeek" 
                                                              Width="14" Height="14"
                                                              Foreground="White"
                                                              VerticalAlignment="Center"/>
                                            <TextBlock Text="Semana" 
                                                      FontSize="12" 
                                                      FontWeight="Bold"
                                                      Foreground="White"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Botón Mensual -->
                                    <Button Command="{Binding ChangePeriodCommand}"
                                           CommandParameter="Monthly"
                                           Width="80"
                                           Height="32"
                                           Padding="8,6"
                                           CornerRadius="6"
                                           Cursor="Hand"
                                           IsEnabled="{Binding !IsLoadingChart}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <icons:MaterialIcon Kind="CalendarMonth" 
                                                              Width="14" Height="14"
                                                              VerticalAlignment="Center"/>
                                            <TextBlock Text="Mes" 
                                                      FontSize="12" 
                                                      FontWeight="SemiBold"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#8E8E93"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                            <Style Selector="Button[IsEnabled=True]:pointerover">
                                                <Setter Property="Background" Value="#2D2D30"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Style>
                                            <Style Selector="Button:disabled">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.IsVisible>
                                            <Binding Path="!IsMonthlyActive"/>
                                        </Button.IsVisible>
                                    </Button>
                                    
                                    <!-- Botón Mensual ACTIVO -->
                                    <Border Width="80"
                                           Height="32"
                                           CornerRadius="6" 
                                           Padding="8,6"
                                           IsVisible="{Binding IsMonthlyActive}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#3B82F6" Offset="0"/>
                                                <GradientStop Color="#2563EB" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <icons:MaterialIcon Kind="CalendarMonth" 
                                                              Width="14" Height="14"
                                                              Foreground="White"
                                                              VerticalAlignment="Center"/>
                                            <TextBlock Text="Mes" 
                                                      FontSize="12" 
                                                      FontWeight="Bold"
                                                      Foreground="White"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                    
                    <!-- VISTA DE RENDIMIENTO -->
                    <StackPanel IsVisible="{Binding IsPerformanceViewActive}" Margin="0,15,0,0">
                        <!-- Contenedor del gráfico con loading -->
                        <Grid Height="300">
                            <!-- Gráfico -->
                            <lvc:CartesianChart Series="{Binding MonthlyPerformanceSeries}"
                                               Opacity="{Binding IsLoadingChart, Converter={StaticResource InverseBoolToOpacityConverter}}"/>
                            
                            <!-- Indicador de carga -->
                            <Border Background="#2D2D30F0" 
                                   CornerRadius="12"
                                   IsVisible="{Binding IsLoadingChart}">
                                <StackPanel HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           Spacing="16">
                                    <Border Width="60" Height="60" 
                                           CornerRadius="30"
                                           BoxShadow="0 4 16 0 #603B82F6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#3B82F6" Offset="0"/>
                                                <GradientStop Color="#2563EB" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <icons:MaterialIcon Kind="ChartLineVariant" 
                                                          Width="32" Height="32"
                                                          Foreground="White"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Cargando datos del gráfico..." 
                                              FontSize="14" 
                                              FontWeight="SemiBold"
                                              Foreground="#FFFFFF"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                    
                    <!-- VISTA DE DISTRIBUCIÓN -->
                    <StackPanel IsVisible="{Binding IsDistributionViewActive}" Margin="0,15,0,0">
                        <lvc:PieChart Series="{Binding AssetDistributionSeries}" 
                                     Height="280"
                                     Margin="0,0,0,15"/>
                        
                        <!-- Leyenda de Colores -->
                        <Border Background="#0F1419" 
                               CornerRadius="12" 
                               Padding="18"
                               BorderBrush="#FFFFFF20"
                               BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel Spacing="12">
                                <TextBlock Text="📊 Leyenda de Distribución" 
                                          FontSize="13" 
                                          FontWeight="ExtraBold"
                                          Foreground="#FFFFFF"
                                          Margin="0,0,0,5"/>
                                
                                <!-- Crypto - Azul -->
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="24" Height="24" 
                                           CornerRadius="6"
                                           Background="#3B82F6"
                                           BorderBrush="#3B82F660"
                                           BorderThickness="2"/>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Criptomonedas" 
                                                  FontSize="13" 
                                                  FontWeight="Bold"
                                                  Foreground="#FFFFFF"/>
                                        <TextBlock Text="Bitcoin, Ethereum, etc." 
                                                  FontSize="11" 
                                                  Foreground="#94A3B8"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Skins - Verde -->
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="24" Height="24" 
                                           CornerRadius="6"
                                           Background="#10B981"
                                           BorderBrush="#10B98160"
                                           BorderThickness="2"/>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Skins CS:GO" 
                                                  FontSize="13" 
                                                  FontWeight="Bold"
                                                  Foreground="#FFFFFF"/>
                                        <TextBlock Text="Armas, guantes, cuchillos" 
                                                  FontSize="11" 
                                                  Foreground="#94A3B8"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Manual - Naranja -->
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="24" Height="24" 
                                           CornerRadius="6"
                                           Background="#F59E0B"
                                           BorderBrush="#F59E0B60"
                                           BorderThickness="2"/>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Manuales" 
                                                  FontSize="13" 
                                                  FontWeight="Bold"
                                                  Foreground="#FFFFFF"/>
                                        <TextBlock Text="Inversiones personalizadas" 
                                                  FontSize="11" 
                                                  Foreground="#94A3B8"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Resumen de Criptomonedas Premium -->
            <Border Classes="card"
                   CornerRadius="20" 
                   Padding="30"
                   BorderThickness="1"
                   BorderBrush="#FFFFFF10"
                   ClipToBounds="False"
                   IsVisible="{Binding CryptoSummaries.Count}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#1E293B" Offset="0"/>
                        <GradientStop Color="#334155" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="25" Opacity="0.4" OffsetY="8"/>
                </Border.Effect>
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,25">
                        <icons:MaterialIcon Grid.Column="0"
                                          Kind="Bitcoin" 
                                          Width="28" Height="28" 
                                          Foreground="#F59E0B"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1"
                                  Text="Resumen de Criptomonedas" 
                                  FontSize="22" 
                                  FontWeight="ExtraBold"
                                  Foreground="#FFFFFF"
                                  VerticalAlignment="Center"/>
                        <Border Grid.Column="3"
                               Background="#8B5CF6"
                               CornerRadius="12"
                               Padding="10,6"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="Counter" Width="16" Height="16" Foreground="White"/>
                                <TextBlock Text="{Binding CryptoSummaries.Count, StringFormat='{}{0} activos'}"
                                          FontSize="12"
                                          FontWeight="Bold"
                                          Foreground="White"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <ItemsControl ItemsSource="{Binding CryptoSummaries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E1E" 
                                       Classes="card"
                                       CornerRadius="12" 
                                       Padding="24" 
                                       Margin="0,0,0,12"
                                       BorderBrush="#3E3E42"
                                       BorderThickness="1"
                                       BoxShadow="0 4 12 0 #22000000">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                                        <!-- Imagen -->
                                        <Border Grid.Column="0"
                                               Width="40" 
                                               Height="40" 
                                               CornerRadius="20"
                                               ClipToBounds="True"
                                               Background="#3C3C3C"
                                               Margin="0,0,20,0">
                                            <Image Source="{Binding ImageUrl, Converter={StaticResource UrlToBitmapConverter}}" 
                                                  Stretch="UniformToFill"/>
                                        </Border>
                                        
                                        <!-- Símbolo y Cantidad -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Symbol}" 
                                                      FontSize="16" 
                                                      FontWeight="Bold"
                                                      Foreground="White"/>
                                            <TextBlock FontSize="12" Foreground="#AAAAAA">
                                                <Run Text="{Binding TotalQuantity, StringFormat='{}{0:N8}'}"/>
                                                <Run Text=" unidades"/>
                                            </TextBlock>
                                        </StackPanel>
                                        
                                        <!-- Precio Actual -->
                                        <StackPanel Grid.Column="2" Margin="20,0" VerticalAlignment="Center">
                                            <TextBlock Text="Precio" FontSize="11" Foreground="#AAAAAA"/>
                                            <TextBlock Text="{Binding CurrentPrice, StringFormat='${0:N2}'}" 
                                                      FontSize="14" 
                                                      FontWeight="Bold"
                                                      Foreground="#4FC3F7"/>
                                        </StackPanel>
                                        
                                        <!-- Valor Total -->
                                        <StackPanel Grid.Column="3" Margin="20,0" VerticalAlignment="Center">
                                            <TextBlock Text="Valor Total" FontSize="11" Foreground="#AAAAAA"/>
                                            <TextBlock Text="{Binding CurrentValue, StringFormat='${0:N2}'}" 
                                                      FontSize="14" 
                                                      FontWeight="Bold"
                                                      Foreground="White"/>
                                        </StackPanel>
                                        
                                        <!-- Ganancia/Pérdida -->
                                        <Border Grid.Column="4"
                                               Background="#3E3E42"
                                               CornerRadius="6"
                                               Padding="15,8"
                                               Margin="20,0"
                                               VerticalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProfitLoss, StringFormat='${0:N2}'}" 
                                                          FontSize="15" 
                                                          FontWeight="Bold"
                                                          Foreground="{Binding ProfitLoss, Converter={StaticResource ProfitLossColorConverter}}"
                                                          HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding ProfitLossPercentage, StringFormat='({0:F2}%)'}" 
                                                          FontSize="12" 
                                                          FontWeight="SemiBold"
                                                          Foreground="{Binding ProfitLoss, Converter={StaticResource ProfitLossColorConverter}}"
                                                          HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Botón Ajustar Earnings -->
                                        <Button Grid.Column="5"
                                               Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).OpenAdjustCryptoDialogCommand}"
                                               CommandParameter="{Binding}"
                                               Classes="modern"
                                               Padding="12,10"
                                               Foreground="White"
                                               CornerRadius="10"
                                               VerticalAlignment="Center"
                                               ToolTip.Tip="Ajustar cantidad por earnings/staking">
                                            <icons:MaterialIcon Kind="ChartTimelineVariant" Width="22" Height="22"/>
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                                    <GradientStop Color="#1D4ED8" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background">
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                            <GradientStop Color="#2563EB" Offset="0"/>
                                                            <GradientStop Color="#1E40AF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter>
                                                </Style>
                                            </Button.Styles>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Inversiones en Criptomonedas -->
            <Border Background="#2D2D30" 
                   Classes="card"
                   CornerRadius="14" 
                   Padding="25"
                   BoxShadow="0 8 16 0 #22000000"
                   BorderBrush="#3E3E42"
                   BorderThickness="1"
                   IsVisible="{Binding CryptoInvestments.Count}">
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
                        <icons:MaterialIcon Grid.Column="0"
                                          Kind="CurrencyBtc" 
                                          Width="24" Height="24" 
                                          Foreground="#3B82F6"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1"
                                  Text="Inversiones en Criptomonedas" 
                                  FontSize="18" 
                                  FontWeight="Bold"
                                  Foreground="#FFFFFF"
                                  VerticalAlignment="Center"/>
                        <Border Grid.Column="2"
                               Background="#3E3E42"
                               CornerRadius="8"
                               Padding="10,6"
                               VerticalAlignment="Center">
                            <TextBlock Text="{Binding CryptoInvestments.Count, StringFormat='{}{0} inversiones'}"
                                      FontSize="12"
                                      FontWeight="SemiBold"
                                      Foreground="#AAAAAA"/>
                        </Border>
                    </Grid>
                    
                    <!-- Vista de Lista Personalizada -->
                    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CryptoInvestments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#252526" 
                                           CornerRadius="8" 
                                           Padding="20" 
                                           Margin="0,0,0,12"
                                           BorderBrush="#3E3E42"
                                           BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                            
                                            <!-- Columna 1: Imagen, Nombre y Tipo -->
                                            <Grid Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,0,30,0">
                                                <!-- Imagen del activo -->
                                                <Border Grid.Column="0"
                                                       Width="50" 
                                                       Height="50" 
                                                       CornerRadius="25"
                                                       ClipToBounds="True"
                                                       Background="#3C3C3C"
                                                       Margin="0,0,15,0"
                                                       VerticalAlignment="Center">
                                                    <Image Source="{Binding ImageUrl, Converter={StaticResource UrlToBitmapConverter}}" 
                                                          Stretch="UniformToFill"/>
                                                </Border>
                                                
                                                <StackPanel Grid.Column="1" 
                                                           VerticalAlignment="Center"
                                                           Width="230">
                                                    <TextBlock Text="{Binding Name}" 
                                                              FontSize="16" 
                                                              FontWeight="Bold"
                                                              Foreground="White"
                                                              TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding AssetType}" 
                                                              FontSize="12" 
                                                              Foreground="#AAAAAA"
                                                              Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            
                                            <!-- Columna 2: Cantidad -->
                                            <StackPanel Grid.Column="1" Margin="0,0,30,0" VerticalAlignment="Center">
                                                <TextBlock Text="📊 Cantidad" 
                                                          FontSize="11" 
                                                          Foreground="#AAAAAA"/>
                                                <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N4}'}" 
                                                          FontSize="15" 
                                                          FontWeight="SemiBold"
                                                          Foreground="White"
                                                          Margin="0,4,0,0"/>
                                            </StackPanel>
                                            
                                            <!-- Columna 3: Total Invertido -->
                                            <StackPanel Grid.Column="2" Margin="0,0,30,0" VerticalAlignment="Center">
                                                <TextBlock Text="� Total Invertido" 
                                                          FontSize="11" 
                                                          Foreground="#AAAAAA"/>
                                                <TextBlock Text="{Binding TotalPurchaseValue, StringFormat='${0:N2}'}" 
                                                          FontSize="15" 
                                                          FontWeight="Bold"
                                                          Foreground="#FFB347"
                                                          Margin="0,4,0,0"/>
                                            </StackPanel>
                                            
                                            <!-- Columna 4: Valor Actual -->
                                            <StackPanel Grid.Column="3" Margin="0,0,30,0" VerticalAlignment="Center">
                                                <TextBlock Text="� Valor Actual" 
                                                          FontSize="11" 
                                                          Foreground="#AAAAAA"/>
                                                <TextBlock Text="{Binding CurrentValue, StringFormat='${0:N2}'}" 
                                                          FontSize="15" 
                                                          FontWeight="Bold"
                                                          Foreground="#4FC3F7"
                                                          Margin="0,4,0,0"/>
                                            </StackPanel>
                                            
                                            <!-- Columna 5: Ganancia/Pérdida y Porcentaje -->
                                            <Border Grid.Column="4"
                                                   Background="#3E3E42"
                                                   CornerRadius="8"
                                                   Padding="20,12"
                                                   Margin="0,0,20,0"
                                                   VerticalAlignment="Center">
                                                <StackPanel>
                                                    <TextBlock Text="📊 Ganancia/Pérdida" 
                                                              FontSize="11" 
                                                              Foreground="#AAAAAA"
                                                              HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ProfitLoss, StringFormat='${0:N2}'}" 
                                                              FontSize="18" 
                                                              FontWeight="Bold"
                                                              Foreground="{Binding ProfitLoss, Converter={StaticResource ProfitLossColorConverter}}"
                                                              HorizontalAlignment="Center"
                                                              Margin="0,4,0,4"/>
                                                    <TextBlock Text="{Binding ProfitLossPercentage, StringFormat='({0:F2}%)'}" 
                                                              FontSize="14" 
                                                              FontWeight="SemiBold"
                                                              Foreground="{Binding ProfitLoss, Converter={StaticResource ProfitLossColorConverter}}"
                                                              HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            
                                            <!-- Columna 6: Botón Eliminar -->
                                            <Button Grid.Column="5"
                                                   Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).DeleteInvestmentCommand}"
                                                   CommandParameter="{Binding}"
                                                   Padding="10,8"
                                                   Background="#DC2626"
                                                   Foreground="White"
                                                   CornerRadius="8"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="Eliminar inversión">
                                                <icons:MaterialIcon Kind="Delete" Width="20" Height="20"/>
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover">
                                                        <Setter Property="Background" Value="#B91C1C"/>
                                                    </Style>
                                                </Button.Styles>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Inversiones en Skins CS:GO -->
            <Border Background="#2D2D30" 
                   Classes="card"
                   CornerRadius="14" 
                   Padding="25"
                   BoxShadow="0 8 16 0 #22000000"
                   BorderBrush="#3E3E42"
                   BorderThickness="1"
                   IsVisible="{Binding SkinInvestments.Count}">
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
                        <icons:MaterialIcon Grid.Column="0"
                                          Kind="SwordCross" 
                                          Width="24" Height="24" 
                                          Foreground="#10B981"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1"
                                  Text="Inversiones en Skins CS:GO" 
                                  FontSize="18" 
                                  FontWeight="Bold"
                                  Foreground="#FFFFFF"
                                  VerticalAlignment="Center"/>
                        <Border Grid.Column="2"
                               Background="#3E3E42"
                               CornerRadius="8"
                               Padding="10,6"
                               VerticalAlignment="Center">
                            <TextBlock Text="{Binding SkinInvestments.Count, StringFormat='{}{0} inversiones'}"
                                      FontSize="12"
                                      FontWeight="SemiBold"
                                      Foreground="#AAAAAA"/>
                        </Border>
                    </Grid>
                    
                    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SkinInvestments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#252526" 
                                           CornerRadius="8" 
                                           Padding="20" 
                                           Margin="0,0,0,12"
                                           BorderBrush="#3E3E42"
                                           BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                            
                                            <!-- Columna 1: Imagen, Nombre y Tipo -->
                                            <Grid Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,0,30,0">
                                                <Border Grid.Column="0"
                                                       Width="50" 
                                                       Height="50" 
                                                       CornerRadius="25"
                                                       ClipToBounds="True"
                                                       Background="#3C3C3C"
                                                       Margin="0,0,15,0"
                                                       VerticalAlignment="Center">
                                                    <Image Source="{Binding ImageUrl, Converter={StaticResource UrlToBitmapConverter}}" 
                                                          Stretch="UniformToFill"/>
                                                </Border>
                                                
                                                <StackPanel Grid.Column="1" 
                                                           VerticalAlignment="Center"
                                                           Width="230">
                                                    <TextBlock Text="{Binding Name}" 
                                                              FontSize="16" 
                                                              FontWeight="Bold"
                                                              Foreground="White"
                                                              TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding AssetType}" 
                                                              FontSize="12" 
                                                              Foreground="#AAAAAA"
                                                              Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            
                                            <StackPanel Grid.Column="1" Margin="0,0,30,0" VerticalAlignment="Center">
                                                <TextBlock Text="📊 Cantidad" 
                                                          FontSize="11" 
                                                          Foreground="#AAAAAA"/>
                                                <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N4}'}" 
                                                          FontSize="15" 
                                                          FontWeight="SemiBold"
                                                          Foreground="White"
                                                          Margin="0,4,0,0"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="2" Margin="0,0,30,0" VerticalAlignment="Center">
                                                <TextBlock Text="💰 Total Invertido" 
                                                          FontSize="11" 
                                                          Foreground="#AAAAAA"/>
                                                <TextBlock Text="{Binding TotalPurchaseValue, StringFormat='${0:N2}'}" 
                                                          FontSize="15" 
                                                          FontWeight="Bold"
                                                          Foreground="#FFB347"
                                                          Margin="0,4,0,0"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="3" Margin="0,0,30,0" VerticalAlignment="Center">
                                                <TextBlock Text="💎 Valor Actual" 
                                                          FontSize="11" 
                                                          Foreground="#AAAAAA"/>
                                                <TextBlock Text="{Binding CurrentValue, StringFormat='${0:N2}'}" 
                                                          FontSize="15" 
                                                          FontWeight="Bold"
                                                          Foreground="#4FC3F7"
                                                          Margin="0,4,0,0"/>
                                            </StackPanel>
                                            
                                            <Border Grid.Column="4"
                                                   Background="#3E3E42"
                                                   CornerRadius="8"
                                                   Padding="20,12"
                                                   Margin="0,0,20,0"
                                                   VerticalAlignment="Center">
                                                <StackPanel>
                                                    <TextBlock Text="📊 Ganancia/Pérdida" 
                                                              FontSize="11" 
                                                              Foreground="#AAAAAA"
                                                              HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ProfitLoss, StringFormat='${0:N2}'}" 
                                                              FontSize="18" 
                                                              FontWeight="Bold"
                                                              Foreground="{Binding ProfitLoss, Converter={StaticResource ProfitLossColorConverter}}"
                                                              HorizontalAlignment="Center"
                                                              Margin="0,4,0,4"/>
                                                    <TextBlock Text="{Binding ProfitLossPercentage, StringFormat='({0:F2}%)'}" 
                                                              FontSize="14" 
                                                              FontWeight="SemiBold"
                                                              Foreground="{Binding ProfitLoss, Converter={StaticResource ProfitLossColorConverter}}"
                                                              HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            
                                            <Button Grid.Column="5"
                                                   Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).DeleteInvestmentCommand}"
                                                   CommandParameter="{Binding}"
                                                   Padding="10,8"
                                                   Background="#DC2626"
                                                   Foreground="White"
                                                   CornerRadius="8"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="Eliminar inversión">
                                                <icons:MaterialIcon Kind="Delete" Width="20" Height="20"/>
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover">
                                                        <Setter Property="Background" Value="#B91C1C"/>
                                                    </Style>
                                                </Button.Styles>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Inversiones Manuales -->
            <Border Background="#2D2D30" 
                   Classes="card"
                   CornerRadius="14" 
                   Padding="25"
                   BoxShadow="0 8 16 0 #22000000"
                   BorderBrush="#3E3E42"
                   BorderThickness="1"
                   IsVisible="{Binding ManualInvestments.Count}">
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
                        <icons:MaterialIcon Grid.Column="0"
                                          Kind="PencilBox" 
                                          Width="24" Height="24" 
                                          Foreground="#F59E0B"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1"
                                  Text="Inversiones Manuales" 
                                  FontSize="18" 
                                  FontWeight="Bold"
                                  Foreground="#FFFFFF"
                                  VerticalAlignment="Center"/>
                        <Border Grid.Column="2"
                               Background="#3E3E42"
                               CornerRadius="8"
                               Padding="10,6"
                               VerticalAlignment="Center">
                            <TextBlock Text="{Binding ManualInvestments.Count, StringFormat='{}{0} inversiones'}"
                                      FontSize="12"
                                      FontWeight="SemiBold"
                                      Foreground="#AAAAAA"/>
                        </Border>
                    </Grid>
                    
                    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ManualInvestments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#252526" 
                                           CornerRadius="8" 
                                           Padding="20" 
                                           Margin="0,0,0,12"
                                           BorderBrush="#3E3E42"
                                           BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                            
                                            <Grid Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,0,30,0">
                                                <Border Grid.Column="0"
                                                       Width="50" 
                                                       Height="50" 
                                                       CornerRadius="25"
                                                       ClipToBounds="True"
                                                       Background="#3C3C3C"
                                                       Margin="0,0,15,0"
                                                       VerticalAlignment="Center">
                                                    <Image Source="{Binding ImageUrl, Converter={StaticResource UrlToBitmapConverter}}" 
                                                          Stretch="UniformToFill"/>
                                                </Border>
                                                
                                                <StackPanel Grid.Column="1" 
                                                           VerticalAlignment="Center"
                                                           Width="230">
                                                    <TextBlock Text="{Binding Name}" 
                                                              FontSize="16" 
                                                              FontWeight="Bold"
                                                              Foreground="White"
                                                              TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding AssetType}" 
                                                              FontSize="12" 
                                                              Foreground="#AAAAAA"
                                                              Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            
                                            <StackPanel Grid.Column="1" Margin="0,0,30,0" VerticalAlignment="Center">
                                                <TextBlock Text="📊 Cantidad" 
                                                          FontSize="11" 
                                                          Foreground="#AAAAAA"/>
                                                <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N4}'}" 
                                                          FontSize="15" 
                                                          FontWeight="SemiBold"
                                                          Foreground="White"
                                                          Margin="0,4,0,0"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="2" Margin="0,0,30,0" VerticalAlignment="Center">
                                                <TextBlock Text="💰 Total Invertido" 
                                                          FontSize="11" 
                                                          Foreground="#AAAAAA"/>
                                                <TextBlock Text="{Binding TotalPurchaseValue, StringFormat='${0:N2}'}" 
                                                          FontSize="15" 
                                                          FontWeight="Bold"
                                                          Foreground="#FFB347"
                                                          Margin="0,4,0,0"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="3" Margin="0,0,30,0" VerticalAlignment="Center">
                                                <TextBlock Text="💎 Valor Actual" 
                                                          FontSize="11" 
                                                          Foreground="#AAAAAA"/>
                                                <TextBlock Text="{Binding CurrentValue, StringFormat='${0:N2}'}" 
                                                          FontSize="15" 
                                                          FontWeight="Bold"
                                                          Foreground="#4FC3F7"
                                                          Margin="0,4,0,0"/>
                                            </StackPanel>
                                            
                                            <Border Grid.Column="4"
                                                   Background="#3E3E42"
                                                   CornerRadius="8"
                                                   Padding="20,12"
                                                   Margin="0,0,20,0"
                                                   VerticalAlignment="Center">
                                                <StackPanel>
                                                    <TextBlock Text="📊 Ganancia/Pérdida" 
                                                              FontSize="11" 
                                                              Foreground="#AAAAAA"
                                                              HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ProfitLoss, StringFormat='${0:N2}'}" 
                                                              FontSize="18" 
                                                              FontWeight="Bold"
                                                              Foreground="{Binding ProfitLoss, Converter={StaticResource ProfitLossColorConverter}}"
                                                              HorizontalAlignment="Center"
                                                              Margin="0,4,0,4"/>
                                                    <TextBlock Text="{Binding ProfitLossPercentage, StringFormat='({0:F2}%)'}" 
                                                              FontSize="14" 
                                                              FontWeight="SemiBold"
                                                              Foreground="{Binding ProfitLoss, Converter={StaticResource ProfitLossColorConverter}}"
                                                              HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            
                                            <Button Grid.Column="5"
                                                   Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).DeleteInvestmentCommand}"
                                                   CommandParameter="{Binding}"
                                                   Padding="10,8"
                                                   Background="#DC2626"
                                                   Foreground="White"
                                                   CornerRadius="8"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="Eliminar inversión">
                                                <icons:MaterialIcon Kind="Delete" Width="20" Height="20"/>
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover">
                                                        <Setter Property="Background" Value="#B91C1C"/>
                                                    </Style>
                                                </Button.Styles>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Barra de estado -->
            <TextBlock Text="{Binding StatusMessage}" 
                      FontSize="12" 
                      Foreground="#7F8C8D"
                      HorizontalAlignment="Right"/>
        </StackPanel>
    </ScrollViewer>

    <!-- Diálogo de Ajuste de Criptomoneda -->
    <Border IsVisible="{Binding IsAdjustmentDialogOpen}"
            Background="#CC000000"
            ZIndex="1000">
        <Border Background="#2D2D30"
               CornerRadius="12"
               Padding="30"
               MaxWidth="500"
               MaxHeight="400"
               BorderBrush="#007ACC"
               BorderThickness="2"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               BoxShadow="0 12 24 0 #88000000">
            <StackPanel Spacing="20">
                <!-- Título -->
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <icons:MaterialIcon Kind="ChartTimelineVariant" Width="28" Height="28" Foreground="#3B82F6" VerticalAlignment="Center"/>
                    <TextBlock Text="Ajustar Cantidad por Earnings" 
                              FontSize="22" 
                              FontWeight="Bold"
                              Foreground="White"
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Información de la cripto -->
                <StackPanel Spacing="10" IsVisible="{Binding SelectedCryptoForAdjustment}">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                  Text="Criptomoneda:" 
                                  FontSize="14" 
                                  Foreground="#AAAAAA"
                                  Margin="0,0,15,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                  Text="{Binding SelectedCryptoForAdjustment.Symbol}" 
                                  FontSize="14" 
                                  FontWeight="Bold"
                                  Foreground="White"
                                  Margin="0,0,0,5"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" 
                                  Text="Cantidad actual:" 
                                  FontSize="14" 
                                  Foreground="#AAAAAA"
                                  Margin="0,0,15,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" 
                                  Text="{Binding SelectedCryptoForAdjustment.TotalQuantity, StringFormat='{}{0:N8} unidades'}" 
                                  FontSize="14" 
                                  Foreground="#4FC3F7"
                                  Margin="0,0,0,5"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" 
                                  Text="Valor actual:" 
                                  FontSize="14" 
                                  Foreground="#AAAAAA"
                                  Margin="0,0,15,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" 
                                  Text="{Binding SelectedCryptoForAdjustment.CurrentValue, StringFormat='${0:N2}'}" 
                                  FontSize="14" 
                                  Foreground="#4CAF50"/>
                    </Grid>
                </StackPanel>
                
                <Border Height="1" Background="#3E3E42"/>
                
                <!-- Input de nueva cantidad -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Nueva cantidad total (después de earnings/staking):" 
                              FontSize="14" 
                              Foreground="White"/>
                    <TextBox Text="{Binding NewCryptoQuantity}"
                            Watermark="Ej: 0.00192500"
                            FontSize="16"
                            Padding="12"
                            Background="#1E1E1E"
                            Foreground="White"
                            BorderBrush="#007ACC"
                            BorderThickness="2"
                            CornerRadius="6"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="5,5,0,0">
                        <icons:MaterialIcon Kind="CheckCircle" Width="14" Height="14" Foreground="#4CAF50" VerticalAlignment="Center"/>
                        <TextBlock FontSize="11"
                                  Foreground="#4CAF50"
                                  TextWrapping="Wrap"
                                  Text="Se creará un nuevo registro marcado como [EARNING]"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="5,3,0,0">
                        <icons:MaterialIcon Kind="LightbulbOn" Width="14" Height="14" Foreground="#FFA726" VerticalAlignment="Center"/>
                        <TextBlock FontSize="11"
                                  Foreground="#FFA726"
                                  TextWrapping="Wrap"
                                  Text="Tus compras originales NO se modificarán (mantiene trazabilidad)"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Botones -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,0">
                    <Button Grid.Column="0"
                           Command="{Binding CloseAdjustCryptoDialogCommand}"
                           Padding="15,10"
                           Background="#424242"
                           Foreground="White"
                           CornerRadius="8"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:MaterialIcon Kind="Close" Width="18" Height="18"/>
                            <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#616161"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    
                    <Button Grid.Column="1"
                           Command="{Binding AdjustCryptoQuantityCommand}"
                           Padding="15,10"
                           Background="#3B82F6"
                           Foreground="White"
                           CornerRadius="8"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:MaterialIcon Kind="Check" Width="18" Height="18"/>
                            <TextBlock Text="Ajustar" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Border>
    </Panel>

</UserControl>
